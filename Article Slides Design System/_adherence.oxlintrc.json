{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/backmatter/**",
              "components/blocks/**",
              "components/core/**",
              "components/frontmatter/**",
              "components/media/**",
              "components/slide/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Abstract'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|keywords|children|style|key|ref|className|style|children)$/]",
        "message": "<Abstract> doesn't accept that prop. Declared props: title, keywords, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Admonition'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|color|simple|hideIcon|children|style|key|ref|className|style|children)$/]",
        "message": "<Admonition> doesn't accept that prop. Declared props: kind, title, color, simple, hideIcon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Admonition'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:note|important|seealso|tip|hint|attention|warning|caution|danger|error)$/]",
        "message": "<Admonition> kind must be one of 'note' | 'important' | 'seealso' | 'tip' | 'hint' | 'attention' | 'warning' | 'caution' | 'danger' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Admonition'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:blue|green|yellow|red)$/]",
        "message": "<Admonition> color must be one of 'blue' | 'green' | 'yellow' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aside'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Aside> doesn't accept that prop. Declared props: kind, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aside'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:margin|sidebar|topic)$/]",
        "message": "<Aside> kind must be one of 'margin' | 'sidebar' | 'topic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Blockquote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|pull|style|key|ref|className|style|children)$/]",
        "message": "<Blockquote> doesn't accept that prop. Declared props: children, attribution, pull, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|icon|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, icon, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|chip)$/]",
        "message": "<Button> variant must be one of 'primary' | 'chip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|filename|executable|showLineNumbers|startingLineNumber|emphasizeLines|style|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: code, filename, executable, showLineNumbers, startingLineNumber, emphasizeLines, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Equation'] > JSXAttribute > JSXIdentifier[name!=/^(?:tex|number|children|style|key|ref|className|style|children)$/]",
        "message": "<Equation> doesn't accept that prop. Declared props: tex, number, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|label|number|caption|ratio|fit|align|children|style|key|ref|className|style|children)$/]",
        "message": "<Figure> doesn't accept that prop. Declared props: src, alt, label, number, caption, ratio, fit, align, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:contain|cover)$/]",
        "message": "<Figure> fit must be one of 'contain' | 'cover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Figure> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|group|href|direction|style|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: title, group, href, direction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:next|prev)$/]",
        "message": "<FooterLink> direction must be one of 'next' | 'prev'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Author'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|affiliations|orcid|email|corresponding|key|ref|className|style|children)$/]",
        "message": "<Author> doesn't accept that prop. Declared props: name, affiliations, orcid, email, corresponding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|title|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, title, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Proof'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|number|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Proof> doesn't accept that prop. Declared props: kind, number, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Proof'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:proof|axiom|lemma|definition|criterion|remark|conjecture|corollary|algorithm|example|property|observation|proposition|assumption|theorem)$/]",
        "message": "<Proof> kind must be one of 'proof' | 'axiom' | 'lemma' | 'definition' | 'criterion' | 'remark' | 'conjecture' | 'corollary' | 'algorithm' | 'example' | 'property' | 'observation' | 'proposition' | 'assumption' | 'theorem'."
      },
      {
        "selector": "JSXOpeningElement[name.name='References'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|start|style|key|ref|className|style|children)$/]",
        "message": "<References> doesn't accept that prop. Declared props: title, items, start, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slide'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|header|margin|footer|align|dark|background|label|style|className|children|key|ref|className|style|children)$/]",
        "message": "<Slide> doesn't accept that prop. Declared props: layout, header, margin, footer, align, dark, background, label, style, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slide'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:body|body-margin|page|center|screen)$/]",
        "message": "<Slide> layout must be one of 'body' | 'body-margin' | 'page' | 'center' | 'screen'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slide'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center|end)$/]",
        "message": "<Slide> align must be one of 'start' | 'center' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:subject|venue|volume|issue|number|total|right|style|key|ref|className|style|children)$/]",
        "message": "<SlideHeader> doesn't accept that prop. Declared props: subject, venue, volume, issue, number, total, right, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Abstract": {
        "replaces": []
      },
      "Admonition": {
        "replaces": []
